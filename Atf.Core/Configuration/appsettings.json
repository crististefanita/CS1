{
  "Modules": {
    "Api": {
      "Config": {
        "Api": {
          "BaseUrl": "https://gorest.co.in",
          "TimeoutSeconds": 30,
          "WriteTestsEnabled": true,
          "TokenEnvironmentVariable": "ATF_API_TOKEN",
          "DefaultAuthProfile": "default",
          "RateLimit": {
            "MaxRetries": 2,
            "DefaultDelaySeconds": 5,
            "MaxDelaySeconds": 65,
            "RetryStatuses": [429],
            "DelayHeaders": ["Retry-After", "retry-after", "x-ratelimit-reset", "X-RateLimit-Reset"]
          },
          "Polling": {
            "TimeoutSeconds": 10,
            "IntervalMilliseconds": 500
          },
          "AuthProfiles": {
            "default": {
              "Type": "bearer",
              "TokenEnvironmentVariable": "ATF_API_TOKEN"
            },
            "anonymous": {
              "Type": "none"
            }
          },
          "Redaction": {
            "Enabled": true,
            "Replacement": "[REDACTED]",
            "RedactLocalPaths": true,
            "LocalPathReplacement": "[LOCAL_PATH]",
            "SensitiveKeys": [
              "access_token",
              "api_key",
              "apikey",
              "authorization",
              "client_secret",
              "password",
              "refresh_token",
              "secret",
              "token"
            ],
            "PiiEnabled": false,
            "PiiKeys": [ "email", "email_address", "phone", "phone_number" ]
          },
          "Routes": {
            "Users": "/public/v2/users",
            "Posts": "/public/v2/posts",
            "UserPosts": "/public/v2/users/{userId}/posts"
          }
        },
        "Reporting": {
          "ReportPath": "artifacts/reports/api-atf-report.html",
          "TimestampEnabled": true,
          "TimestampFormat": "yyyy-MM-dd_HH-mm-ss",
          "DocumentTitle": "ATF API — Extent report",
          "ReportName": "Configurable API Automation",
          "ConsoleDetails": true,
          "AssertionMaxDisplayCharacters": 240,
          "TestClassOrder": [
            "UsersApiTests",
            "PostsApiTests",
            "ApiLifecycleAndCombinationsTests"
          ],
          "TestScenarioOrder": [
            "POSTS API — setup → test → teardown",
            "Users lifecycle — setup → test → cleanup teardown",
            "USERS API — setup → test",
            "POSTS API — test → teardown",
            "Users API — setup → body → teardown"
          ],
          "TagOrder": [
            "api",
            "smoke",
            "combination",
            "contract",
            "posts",
            "lifecycle",
            "users",
            "relationship",
            "negative",
            "write",
            "auth"
          ],
          "TagTaxonomy": {
            "SelectionTagNames": [
              "api",
              "smoke",
              "combination",
              "contract",
              "posts",
              "lifecycle",
              "users",
              "relationship",
              "negative",
              "write",
              "auth"
            ],
            "DiagnosticTagNames": [
              "warning",
              "skip",
              "failure",
              "teardown",
              "soft-assert",
              "reporting",
              "failure-demo",
              "lifecycle-combination"
            ]
          }
        }
      }
    }
  }
}
